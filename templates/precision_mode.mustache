{{!
    @template tiny_c4lauthor/precision_mode

    Precision Mode — two-panel view for editing individual component fields.

    Classes required for JS:
    * .tiny_c4lauthor__precision-preview  — iframe preview container
    * .tiny_c4lauthor__precision-form     — right-hand form panel
    * .tiny_c4lauthor__precision-placeholder — initial placeholder text

    Context variables required: none (all content injected by JS).

    @copyright  2026 Roger Segú <rogersegu@gmail.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {}
}}
<div class="tiny_c4lauthor__precision">
    <div class="tiny_c4lauthor__precision-body">
        <div class="tiny_c4lauthor__precision-preview"></div>
        <div class="tiny_c4lauthor__precision-form">
            <div class="tiny_c4lauthor__precision-placeholder">
                {{#str}}precision_placeholder, tiny_c4lauthor{{/str}}
            </div>
        </div>
    </div>
</div>
